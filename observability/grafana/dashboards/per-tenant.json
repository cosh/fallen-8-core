{
  "uid": "fallen8-per-tenant",
  "title": "Fallen-8 - Tenant / instance drill-down",
  "description": "Per tenant/instance/namespace: transaction, WAL, checkpoint, graph, index, codegen, HTTP, algorithm, and MCP-tool signals, plus scoped traces and logs.",
  "tags": [
    "fallen8",
    "tenant",
    "observability"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(fallen8_namespace_info, fallen8_tenant_id)",
        "query": {
          "qryType": 1,
          "query": "label_values(fallen8_namespace_info, fallen8_tenant_id)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "refresh": 2,
        "regex": "",
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(fallen8_namespace_info{fallen8_tenant_id=~\"$tenant\"}, fallen8_instance_id)",
        "query": {
          "qryType": 1,
          "query": "label_values(fallen8_namespace_info{fallen8_tenant_id=~\"$tenant\"}, fallen8_instance_id)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "refresh": 2,
        "regex": "",
        "sort": 1
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(fallen8_namespace_info{fallen8_tenant_id=~\"$tenant\", fallen8_instance_id=~\"$instance\"}, fallen8_namespace_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(fallen8_namespace_info{fallen8_tenant_id=~\"$tenant\", fallen8_instance_id=~\"$instance\"}, fallen8_namespace_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
