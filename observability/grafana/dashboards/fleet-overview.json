{
  "uid": "fallen8-fleet-overview",
  "title": "Fallen-8 - Fleet overview",
  "description": "All tenants: liveness, namespace inventory, commit p99, queue depth, WAL degraded, throughput, and busiest actions across REST routes, algorithms, and MCP tools.",
  "tags": [
    "fallen8",
    "fleet",
    "observability"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(fallen8_namespace_info, fallen8_tenant_id)",
        "query": {
          "qryType": 1,
          "query": "label_values(fallen8_namespace_info, fallen8_tenant_id)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "refresh": 2,
        "regex": "",
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(fallen8_namespace_info{fallen8_tenant_id=~\"$tenant\"}, fallen8_instance_id)",
        "query": {
          "qryType": 1,
          "query": "label_values(fallen8_namespace_info{fallen8_tenant_id=~\"$tenant\"}, fallen8_instance_id)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "refresh": 2,
        "regex": "",
        "sort": 1
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(fallen8_namespace_info{fallen8_tenant_id=~\"$tenant\", fallen8_instance_id=~\"$instance\"}, fallen8_namespace_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(fallen8_namespace_info{fallen8_tenant_id=~\"$tenant\", fallen8_instance_id=~\"$instance\"}, fallen8_namespace_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "refresh": 2,
        "regex": "",
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Instances up / ready",
      "description": "One row per reporting instance (presence == up). Value = namespace count for that instance.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Namespaces"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count by (fallen8_tenant_id, fallen8_tenant_name, fallen8_instance_id, fallen8_instance_name) (fallen8_namespace_info{fallen8_tenant_id=~\"$tenant\", fallen8_instance_id=~\"$instance\"})",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "fallen8_tenant_id": "Tenant id",
              "fallen8_tenant_name": "Tenant",
              "fallen8_instance_id": "Instance id",
              "fallen8_instance_name": "Instance"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Namespace inventory",
      "description": "fallen8_namespace_info - the id -> name registry across the fleet.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "fallen8_namespace_info{fallen8_tenant_id=~\"$tenant\", fallen8_instance_id=~\"$instance\", fallen8_namespace_name=~\"$namespace\"}",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "fallen8_tenant_name": "Tenant",
              "fallen8_instance_name": "Instance",
              "fallen8_scope_id": "Namespace id",
              "fallen8_namespace_name": "Namespace"
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "WAL degraded (alert)",
      "description": "Any instance/namespace whose WAL durability fence has tripped. Empty == healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 9
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "noValue": "OK",
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by(fallen8_instance_id, fallen8_scope_id)(fallen8_wal_degraded{fallen8_tenant_id=~\"$tenant\", fallen8_instance_id=~\"$instance\"}) == 1",
          "legendFormat": "{{fallen8_instance_id}} / {{fallen8_scope_id}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Commit duration p99 (per tenant)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 9
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (fallen8_tenant_id, le) (rate(fallen8_transaction_commit_duration_bucket{fallen8_tenant_id=~\"$tenant\", fallen8_instance_id=~\"$instance\"}[5m])))",
          "legendFormat": "{{fallen8_tenant_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Transaction queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 9
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (fallen8_scope_id, fallen8_instance_id) (fallen8_transaction_queue_depth{fallen8_tenant_id=~\"$tenant\", fallen8_instance_id=~\"$instance\"}) * on(fallen8_scope_id, fallen8_instance_id) group_left(fallen8_namespace_name) fallen8_namespace_info{fallen8_instance_id=~\"$instance\", fallen8_namespace_name=~\"$namespace\"}",
          "legendFormat": "{{fallen8_namespace_name}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Commit / rollback throughput (per tenant)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (fallen8_tenant_id) (rate(fallen8_transaction_commits{fallen8_tenant_id=~\"$tenant\", fallen8_instance_id=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "commits {{fallen8_tenant_id}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (fallen8_tenant_id) (rate(fallen8_transaction_rollbacks{fallen8_tenant_id=~\"$tenant\", fallen8_instance_id=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "rollbacks {{fallen8_tenant_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top-N busiest actions (REST routes / algorithms / MCP tools)",
      "description": "A: REST routes by request rate. B: algorithm spans by call rate. C: MCP tools by call rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Rate",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Rate"
              },
              {
                "id": "unit",
                "value": "ops"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (http_route) (rate(http_server_request_duration_count{fallen8_tenant_id=~\"$tenant\", fallen8_instance_id=~\"$instance\"}[5m])))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (span_name, algorithm) (rate(traces_span_metrics_calls{fallen8_tenant_id=~\"$tenant\", fallen8_instance_id=~\"$instance\", algorithm!=\"\"}[5m])))",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (tool) (rate(fallen8_mcp_tool_calls{fallen8_tenant_id=~\"$tenant\", fallen8_instance_id=~\"$instance\"}[5m])))",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "http_route": "REST route",
              "span_name": "Algorithm span",
              "algorithm": "Algorithm",
              "tool": "MCP tool"
            }
          }
        }
      ]
    }
  ]
}