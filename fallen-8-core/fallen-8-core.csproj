<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NoSQL.GraphDB.Core</RootNamespace>
    <PackageId>Fallen-8</PackageId>
    <!-- Versions derive from the git tag vX.Y.Z (MinVer, wired in Directory.Build.props);
         nothing is hardcoded here. Historical record of breaking engine-surface changes:
         0.0.x -> 0.1.0: breaking change to the public engine model surface. VertexModel.OutEdges/
         InEdges are now read-only views (IReadOnlyDictionary<string, IReadOnlyList<EdgeModel>>) and
         TryGetOutEdge/TryGetInEdge return IReadOnlyList<EdgeModel> instead of the mutable
         ImmutableDictionary/ImmutableList (adjacency-flattening). The REST api/v{version} contract is
         unchanged.
         0.1.0 -> 0.2.0: breaking change to the whole-graph read surface. GetAllVertices/GetAllEdges/
         GetAllGraphElements and IndexScan/RangeIndexScan now return IReadOnlyList<T> (backed by a
         right-sized List) instead of ImmutableList<T>, dropping the per-call AVL tree
         (scan-result-representation). Common members (.Count, indexer, foreach, LINQ) are unchanged;
         only ImmutableList-specific members are lost. IIndex return types are unchanged, and the REST
         api/v{version} contract is unchanged (controllers project to DTOs).
         0.2.0 -> 0.3.0: breaking change to the IIndex contract. IIndex gains a required
         Boolean SupportsPointEqualityLookup, the single home for "can this index be looked up by an
         exact key" (equality capability), replacing the type-switches that had drifted between the
         /status inventory and the semantic layer (consolidation-audit CA-1). Every built-in index
         implements it; an external IIndex implementer must add it. No REST api/v{version} change.
         0.3.0 -> 0.4.0: breaking change to the ANNOTATIONS on the public read surface, not to its
         signatures. The string-named IFallen8Read members (TryCalculateShortestPath by plugin name,
         TryRunAnalytics) now carry [RequiresUnreferencedCode], and the type parameter of the typed
         TryCalculateShortestPath<T> carries [DynamicallyAccessedMembers] (trim-safety). Nothing was
         renamed, no constraint was added and no behaviour changed, so this is binary-compatible and
         invisible to a consumer that does not run the trim analyzer. A consumer that DOES run it must
         mirror the annotations on its own code: measured, the analyzer reports IL2046 on an
         IFallen8Read implementation that omits [RequiresUnreferencedCode], IL2095 on a type parameter
         whose [DynamicallyAccessedMembers] does not match the one it implements, and IL2091 on a
         consumer's own generic wrapper that forwards T without the annotation - warnings that fail a
         build treating warnings as errors. No REST api/v{version} change. -->
    <Authors>Henning Rauch</Authors>
    <Company>RauchEntwicklung</Company>
    <Copyright>Copyright (c) 2011-2026 Henning Rauch</Copyright>
    <Description>Fallen-8 is an in-memory graph database implemented in C#. Its focus is to provide raw speed for heavy graph algorithms.</Description>
    <PackageIcon>iconwhite.png</PackageIcon>
    <PackageProjectUrl>https://www.fallen-8.com</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/cosh/fallen-8-core</RepositoryUrl>
    <PackageTags>graph;database;inmemory</PackageTags>
    <!-- Debuggable releases: portable PDBs in a .snupkg symbols package, source link into the
         GitHub repo (the SDK's built-in source link support picks up RepositoryUrl), untracked
         (generated) sources embedded. Deterministic build is the SDK default; the release
         workflow adds -p:ContinuousIntegrationBuild=true so paths normalize in CI. -->
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Trimming. The engine is annotated for the IL trimmer, so it declares itself trim-compatible
       (IsTrimmable) and keeps the trim ANALYZER on for every build. Because warnings are errors here,
       that analyzer is the gate: new reflection either becomes statically analyzable (a
       DynamicallyAccessedMembers annotation, as on the typed path/subgraph overloads) or declares its
       requirement with [RequiresUnreferencedCode] so a trimming consumer is warned at its own call
       site. Without this, a consumer publishing trimmed got IL2104 ("assembly produced trim
       warnings") and, worse, a MissingMethodException at runtime. -->
  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <!-- Explicit garbage collector configuration (N5). The engine keeps a large resident graph
       in memory, which favours Server GC with background (concurrent) collection. A non-web
       host of this library defaults to Workstation GC, so these settings are declared here to
       express the intended mode for such hosts (the app applies them via its own project too).
       DATAS is left at the .NET 10 runtime default; see
       features/dotnet10-modernization/spec.md for the trade-off. -->
  <PropertyGroup>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="pics\**" />
    <EmbeddedResource Remove="pics\**" />
    <None Remove="pics\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\pics\iconwhite.png" Pack="true" PackagePath="\" />
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.0" />
  </ItemGroup>

</Project>
