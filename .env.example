# Copy this file to `.env` (beside docker-compose.yml) and uncomment what you need.
# `.env` is gitignored, so credentials stay out of the repository.
#
# Both docker compose and the `npm run env:*` helper scripts read `.env`, so a variable
# here also drives what env:up decides (which overlays apply, which profiles start).
# A variable set in the shell wins over this file.
#
# The full variable list lives at https://docs.fallen-8.com/running/ - this file only
# carries the ones people set once and keep.

# --- Model provider (https://docs.fallen-8.com/model-providers/): where the two model
# capabilities send their requests. Default `local` is the Ollama sidecar this compose starts.
# `openai` and `anthropic` move CHAT only - embeddings stay on the sidecar, because a hosted
# embedding model is a different embedding function and every vector you have stored would report
# an identity mismatch. Only the key of the provider you pick is needed.
#F8_MODEL_PROVIDER=openai
#F8_OPENAI_API_KEY=your-key
#F8_OPENAI_CHAT_MODEL=gpt-4o-mini
#F8_ANTHROPIC_API_KEY=your-key
#F8_ANTHROPIC_CHAT_MODEL=claude-opus-5

# Chat serves two purposes and each picks its own model, because they want opposite things: the
# `assist` model turns a sentence into a query and may be a fine-tune, while the `agent` model has
# to call tools, which a fine-tune trained on one output shape does not do. Leaving these unset does
# NOT reuse the chat model above: each overlay falls back to its own fixed default, so a changed
# chat model leaves the agent model where it was. Set both when you change one.
#F8_OPENAI_AGENT_MODEL=gpt-4o-mini
#F8_ANTHROPIC_AGENT_MODEL=claude-opus-5

# --- Nahil (https://docs.fallen-8.com/nahil/): the one provider that also moves EMBEDDINGS, and
# only because it serves the same bge-m3, so nothing re-embeds. The key is the whole switch here:
# setting it selects Nahil with no F8_MODEL_PROVIDER line at all.
#F8_NAHIL_API_KEY=your-key
#F8_NAHIL_URL=https://api.nahil.dev
#F8_NAHIL_CHAT_MODEL=phi4-f8-mini:latest
#F8_NAHIL_AGENT_MODEL=phi4-mini:latest
#F8_NAHIL_EMBED_MODEL=bge-m3:latest

# --- Security (https://docs.fallen-8.com/security/): set and the ENTIRE data plane
# requires the key on every request; unset = open (the local-demo default).
#F8_API_KEY=change-me

# --- Ports
#F8_PORT=8080
#F8_UI_PORT=8081

# --- Capabilities (all default on; false is a true opt-out)
#F8_INGESTION=false
#F8_NLP=false
#F8_INTEGRATIONS=false

# --- Agents (https://docs.fallen-8.com/agents/). The ONE capability that is off by default, and
# not out of caution: an agent decides for itself which tools to call, so turning it on is a
# decision to make rather than one to inherit. true brings up the f8-agents sidecar AND flips the
# instance's own /agents routes on; the sidecar has no host port, so from outside the compose
# network the API proxy is the only way in, while inside it every service can reach the sidecar
# directly and it authenticates nobody. It holds no model configuration: every model call goes to
# this instance's POST /chat with purpose: agent, so the model is whatever
# Fallen8:Chat:<Backend>:Models:Agent resolves to.
# Case does not matter (the instance parses it as a Boolean and the scripts lowercase it), and
# env:up refuses any value that is neither true nor false rather than reading it as false. Plain
# docker compose does not: a value that is not a Boolean at all, 1 and 0 included, makes the
# instance's configuration binding throw during startup, so the container restart-loops and
# answers nothing rather than answering an error.
#F8_AGENTS=true

# --- Agents: the model the ollama sidecar pulls for the agent purpose, pulled only when
# F8_AGENTS is true. The default is already present in a normal setup (F8_PULL_ASSIST pulls it),
# so it matters when you name a different one. It does not put agents on a local model while chat
# runs hosted: one Fallen8:Chat:Backend serves both purposes, so an OpenAI or Anthropic instance
# resolves the agent purpose on that provider. Measured: the default emits no parsed tool call
# once ANY instruction text is present, so a deployment that wants agents which actually call
# tools should name a tool-capable model here AND in Fallen8__Chat__<Backend>__Models__Agent for
# the backend that is actually serving.
#F8_AGENT_MODEL=phi4-mini:latest

# --- Integrations trust lists (https://docs.fallen-8.com/integrations/)
#F8_INTEGRATIONS_ALLOWED_HOSTS=console.lan,inverter.lan
#F8_INTEGRATIONS_SELF_SIGNED_HOSTS=console.lan

# --- Integrations: summary-embedding chunks in flight at once. Defaults to 1 with the local
# sidecar (a single-slot model answers one request at a time, so a queued request only burns its
# own clock) and to 4 on Nahil, where the round trip is mostly network. Setting this overrides
# both. Note 4 is above what the target's own rate limit sustains, which is survivable by design:
# a 429 drops the phase back to sequential, waits out the window and re-asks. To make a higher
# number actually hold, raise Fallen8:Security:SensitiveRateLimitPermitPerWindow with it.
#F8_INTEGRATIONS_EMBED_CONCURRENCY=4

# --- GPU: unset auto-detects via nvidia-smi; 1 forces the NVIDIA GPU, 0 forces CPU-only
#F8_GPU=0
