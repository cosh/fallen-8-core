{
  // Declaration emission for the library artifact (feature studio-embeddable, phase 6).
  // The base config typechecks app + tests with noEmit; this one emits ONLY .d.ts for src/,
  // so the exports map's "types" condition can point at dist-lib/types/embed/index.d.ts.
  // Test-only ambient types are dropped: tests are excluded from this program.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist-lib/types",
    "types": ["vite/client"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "dist-lib", "e2e"]
}
