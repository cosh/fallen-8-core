{
  "name": "fallen-8-web-ui",
  "private": true,
  "version": "0.1.0",
  "description": "F8 Studio - browser frontend for Fallen-8 instances",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-lib/types/embed/index.d.ts",
      "default": "./dist-lib/f8-studio.js"
    },
    "./styles.css": "./dist-lib/f8-studio.css",
    "./package.json": "./package.json"
  },
  "main": "./dist-lib/f8-studio.js",
  "types": "./dist-lib/types/embed/index.d.ts",
  "files": [
    "dist-lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:apiapp": "tsc -b && vite build --outDir ../fallen-8-core-apiApp/wwwroot --emptyOutDir",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/check-lib-artifact.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:embed": "playwright test -c playwright.embed.config.ts",
    "embed-smoke:serve": "npm run build:lib && npm --prefix e2e-embed/host ci --prefer-offline --no-audit --no-fund && npm --prefix e2e-embed/host run build && npm --prefix e2e-embed/host run preview",
    "build:samples": "vite-node scripts/build-samples.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@react-sigma/core": "^5.0.4",
    "@sigma/edge-curve": "^3.1.0",
    "@sigma/node-image": "^3.0.0",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.105.0",
    "3d-force-graph": "^1.80.0",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "monaco-editor": "^0.52.2",
    "sigma": "^3.0.1",
    "three": "^0.185.1",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tailwindcss/vite": "^4.0.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.5"
  }
}
