{
  "name": "@fallen-8/studio",
  "version": "0.0.0",
  "description": "F8 Studio - browser frontend for Fallen-8 instances, and its graph canvas as a standalone component",
  "license": "MIT",
  "author": "Henning Rauch",
  "homepage": "https://docs.fallen-8.com/embed-studio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosh/fallen-8-core.git",
    "directory": "fallen-8-web-ui"
  },
  "bugs": {
    "url": "https://github.com/cosh/fallen-8-core/issues"
  },
  "keywords": [
    "fallen-8",
    "graph",
    "graph-database",
    "graph-visualization",
    "react",
    "sigma"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-lib/types/embed/index.d.ts",
      "default": "./dist-lib/f8-studio.js"
    },
    "./canvas": {
      "types": "./dist-lib/types/embed/canvas.d.ts",
      "default": "./dist-lib/canvas.js"
    },
    "./styles.css": "./dist-lib/f8-studio.css",
    "./package.json": "./package.json"
  },
  "main": "./dist-lib/f8-studio.js",
  "types": "./dist-lib/types/embed/index.d.ts",
  "files": [
    "dist-lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:apiapp": "tsc -b && vite build --outDir ../fallen-8-core-apiApp/wwwroot --emptyOutDir",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/check-lib-artifact.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:embed": "playwright test -c playwright.embed.config.ts",
    "embed-smoke:serve": "npm run build:lib && npm --prefix e2e-embed/host ci --prefer-offline --no-audit --no-fund && npm --prefix e2e-embed/host run build && npm --prefix e2e-embed/host run preview",
    "build:samples": "vite-node scripts/build-samples.ts"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "3d-force-graph": "^1.80.0",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.50.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@react-sigma/core": "^5.0.4",
    "@sigma/edge-curve": "^3.1.0",
    "@sigma/node-image": "^3.0.0",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.105.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.0.0",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "jsdom": "^26.0.0",
    "monaco-editor": "^0.52.2",
    "postcss": "^8.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sigma": "^3.0.1",
    "tailwindcss": "^4.0.6",
    "three": "^0.185.1",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.5",
    "zustand": "^5.0.3"
  }
}
